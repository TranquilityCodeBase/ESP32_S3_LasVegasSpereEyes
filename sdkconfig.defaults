# Target: ESP32-S3R8 (Waveshare ESP32-S3-Touch-LCD-2.8C), 16 MB flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Speed
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# PSRAM for the frame buffers (values from the Waveshare demo)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Run code and constants from PSRAM so flash writes (NVS) don't stall the panel
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# RGB panel: ISR stays in IRAM
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# Keep "restart in vsync" OFF. In ESP-IDF 5.5 that option never resets the driver's bounce buffer
# counter, so one missed refill interrupt leaves the picture slipped by one bounce buffer (20 lines)
# until reboot: the top rows show up as a flat band at the bottom, and short stale lines appear at
# the left edge every 20 lines. With it off, the driver checks each frame and resyncs by itself.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=n

# Wi-Fi (ESP-NOW only): keep its buffers in PSRAM so the panel's internal RAM stays free
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
